{
  "name": "joyit-staffing",
  "version": "2.0.1",
  "description": "JoyIT Staffing Intelligence Suite — Currency Converter, Payroll Margin Calculator & World Compliance",
  "main": "main.js",
  "author": {
    "name": "Joy IT Solutions",
    "email": "vikas@joyitsolutions.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac"
  },
  "build": {
    "appId": "com.joyitsolutions.staffing",
    "productName": "JoyIT Staffing Suite",
    "copyright": "Copyright © 2026 Joy IT Solutions. All rights reserved.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "Joy IT Solutions"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JoyIT Staffing Suite",
      "include": "installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "JoyIT Staffing Suite",
      "icon": "assets/icon.icns"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vikas1716-JOY",
        "repo": "joyit-staffing-releases"
      }
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  }
}